{
  "manifest_version": 3,
  "name": "AssignPad Bridge",
  "version": "1.0.0",
  "description": "Sends your WebAssign session to your own AssignPad server so it can sync and submit for you.",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": ["https://*.webassign.net/*", "https://*.cengage.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "AssignPad Bridge" },
  "icons": { "128": "icon128.png" }
}
